{
  "name": "Google Sheets row to Jira",
  "nodes": [
    {
      "parameters": {
        "content": "## Sheet row to Jira\n\nHeaders: Summary, Description, Priority, Issue Key, Status.\nSet the spreadsheet id on both Google nodes, and the Jira project and issue type ids.",
        "height": 160,
        "width": 480,
        "color": 4
      },
      "id": "ef4f03fb-2116-55d5-9d10-2255f040411f",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        40
      ]
    },
    {
      "parameters": {
        "authentication": "triggerOAuth2",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "your-spreadsheet-id"
        },
        "sheetName": {
          "__rl": true,
          "mode": "id",
          "value": "0"
        },
        "event": "rowAdded",
        "options": {}
      },
      "id": "b71900a2-6875-5ffe-94e7-192c625f01d3",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "2ab6308d-621a-5195-b9eb-e1c240cab5c2",
              "leftValue": "={{ $json.Summary }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "db1e821d-1a92-5c85-905e-6bd03e9cf8ca",
      "name": "Summary present",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "jiraVersion": "cloud",
        "resource": "issue",
        "operation": "create",
        "project": {
          "__rl": true,
          "mode": "id",
          "value": "10000"
        },
        "issueType": {
          "__rl": true,
          "mode": "id",
          "value": "10001"
        },
        "summary": "={{ $json.Summary }}",
        "additionalFields": {
          "description": "={{ 'Priority: ' + ($json.Priority || 'Unspecified') + '\\n\\n' + ($json.Description || '') }}"
        }
      },
      "id": "813af561-cdfa-5eec-b6ee-64f7ec7e33ce",
      "name": "Create Jira issue",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [
        800,
        200
      ]
    },
    {
      "parameters": {
