        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "your-spreadsheet-id"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Inbox"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Google Sheets Trigger').item.json.row_number }}",
            "Issue Key": "={{ $json.key }}",
            "Status": "Created"
          },
          "matchingColumns": [
