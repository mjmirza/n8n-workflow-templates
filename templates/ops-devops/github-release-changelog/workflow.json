{
  "name": "GitHub release changelog",
  "nodes": [
    {
      "parameters": {
        "content": "## Release changelog\n\nFires when a GitHub release is published.\nNotes are truncated to 2500 characters.",
        "height": 140,
        "width": 400,
        "color": 4
      },
      "id": "67041917-ac8c-562c-8edd-c9ec571ce276",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        40
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "repository",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "your-org"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "your-repo"
        },
        "events": [
          "release"
        ]
      },
      "id": "b977f906-a9f7-5139-8787-66d60bd21c6e",
      "name": "GitHub Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "85f6ec9f-f2e4-5865-aade-7ed0b5a84270"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a4624173-9471-5d78-aea3-a534fe578954",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "published",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "06c5f9b8-07ea-54cc-82bd-286eb3f1f701",
      "name": "Published release",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = items[0].json.body || {};\nconst release = body.release || {};\nconst repo = body.repository || {};\nlet notes = String(release.body || '').trim();\nif (!notes) notes = 'No release notes provided.';\nif (notes.length > 2500) notes = notes.slice(0, 2500) + '\\n...';\n\nconst lines = [\n  '*' + (repo.full_name || 'repository') + '* ' + (release.tag_name || ''),\n];\nif (release.name && release.name !== release.tag_name) lines.push(release.name);\nif (release.html_url) lines.push(release.html_url);\nlines.push('');\nlines.push(notes);\n\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
      "id": "7113430f-f925-568a-9735-7dc49a507d05",
      "name": "Format changelog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops-alerts"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "id": "81b45c19-846b-5edb-b303-efbb09a3e5bc",
      "name": "Post changelog",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1040,
        200
      ]
    }
  ],
  "connections": {
