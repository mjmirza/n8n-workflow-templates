{
  "name": "GitHub PR opened to Slack",
  "nodes": [
    {
      "parameters": {
        "content": "## GitHub PR opened to Slack\n\nSet the GitHub owner and repository, then the Slack channel.\nDraft PRs are skipped. Activate the workflow so n8n can register the GitHub webhook.",
        "height": 180,
        "width": 460,
        "color": 4
      },
      "id": "11d1928e-62d0-5003-a106-3d09a9e9ab9e",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        40
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "repository",
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "your-org"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "your-repo"
        },
        "events": [
          "pull_request"
        ]
      },
      "id": "5b9dd4ba-60b1-5d59-b8fb-48ff30c88283",
      "name": "GitHub Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "134d2fe6-8f3b-5534-8c57-b353798f1dbe"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d108f08b-2d47-5181-9131-91d9e2fdc682",
              "leftValue": "={{ $json.body.action }}",
              "rightValue": "opened",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "ab6d6445-284d-53a4-974e-22e6ce2fd774",
              "leftValue": "={{ $json.body.pull_request.draft }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "754d7b5c-9312-511a-85d0-4af7e240adbb",
      "name": "Opened and not a draft",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops-alerts"
        },
        "text": "=*PR opened* in {{ $json.body.repository.full_name }}\n<{{ $json.body.pull_request.html_url }}|#{{ $json.body.pull_request.number }} {{ $json.body.pull_request.title }}>\nAuthor: {{ $json.body.pull_request.user.login }}",
        "otherOptions": {
          "mrkdwn": true
        }
      },
      "id": "a0e72f40-56ce-5cd9-bbe5-d68f4ed2befa",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        800,
        220
      ]
    }
  ],
  "connections": {
    "GitHub Trigger": {
      "main": [
        [
          {
            "node": "Opened and not a draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Opened and not a draft": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
