      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const execution = items[0].json.execution || {};\nconst error = execution.error || {};\nconst workflow = items[0].json.workflow || {};\nconst lines = [\n  '*Workflow error*',\n  'Workflow: ' + (workflow.name || 'unknown') + ' (' + (workflow.id || 'n/a') + ')',\n  'Execution: ' + (execution.id || 'n/a') + (execution.mode ? ' (' + execution.mode + ')' : ''),\n  'Last node: ' + (execution.lastNodeExecuted || 'unknown'),\n  'Message: ' + (error.message || 'unknown error'),\n];\nif (execution.url) {\n  lines.push('Open: ' + execution.url);\n}\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
      "id": "1c45101d-3db2-5759-90c8-da7ba19087ce",
      "name": "Build error message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
