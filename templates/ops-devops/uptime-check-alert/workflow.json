            "index": 0
          }
        ]
      ]
    },
    "Classify result": {
      "main": [
        [
          {
            "node": "Is down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is down": {
      "main": [
        [
          {
            "node": "Alert Slack",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
