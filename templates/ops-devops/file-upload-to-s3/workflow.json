              "value": "={{ $json.contentType }}"
            },
            {
              "key": "note",
              "value": "={{ $json.note }}"
            }
          ]
        }
      },
      "id": "50a63973-15d8-5d34-a870-d98d8228c790",
      "name": "Upload to S3",
      "type": "n8n-nodes-base.awsS3",
      "typeVersion": 2,
      "position": [
        1020,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, bucket: $('Build object key').item.json.bucket, key: $('Build object key').item.json.key }) }}",
        "options": {
