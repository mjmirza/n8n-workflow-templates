      "id": "ba224c97-0bb3-5203-8c9f-f1c3af373763",
      "name": "HMAC SHA256",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function headerValue(headers, name) {\n  const want = name.toLowerCase();\n  for (const key of Object.keys(headers || {})) {\n    if (String(key).toLowerCase() === want) return headers[key];\n  }\n  return '';\n}\n\nfunction same(left, right) {\n  const a = String(left);\n  const b = String(right);\n  const length = Math.max(a.length, b.length);\n  let diff = a.length === b.length ? 0 : 1;\n  for (let i = 0; i < length; i++) {\n    const ca = i < a.length ? a.charCodeAt(i) : 0;\n    const cb = i < b.length ? b.charCodeAt(i) : 0;\n    diff |= ca ^ cb;\n  }\n  return diff === 0;\n}\n\nconst headers = items[0].json.headers || {};\nconst provided = String(headerValue(headers, 'x-signature-256')).trim();\nconst computed = String(items[0].json.computedSignature || '').trim().toLowerCase();\nconst normalized = (provided.toLowerCase().startsWith('sha256=')\n  ? provided.slice('sha256='.length)\n  : provided).trim().toLowerCase();\nconst valid = computed.length > 0 && same(normalized, computed);\n\nconst output = {\n  valid,\n  reason: valid ? 'ok' : (provided ? 'signature mismatch' : 'missing signature header'),\n};\nif (valid) output.body = items[0].json.body;\n\nreturn [{ json: output }];\n"
      },
