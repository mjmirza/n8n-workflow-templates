    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst approved = raw?.data?.approved === true || raw?.approved === true;\nconst draft = $('Assemble Draft').first().json;\nreturn [{ json: { approved, to: draft.to, subject: draft.subject, body: draft.body, requester: draft.requester } }];\n"
      },
