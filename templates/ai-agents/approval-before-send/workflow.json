        "options": {
          "temperature": 0.3
        }
      },
      "id": "32c1c4da-da50-4ede-9c9a-0df46259c61b",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1000,
        380
      ]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"subject\": \"April invoice copy\",\n  \"body\": \"Hi Northwind, the April invoice is attached in the thread. The total is 88 USD.\"\n}"
      },
      "id": "794b5bc6-7c9c-49c4-8bbb-4b0e7bc7074a",
      "name": "Email Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1220,
        380
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const request = $('Normalize Request').first().json;\nconst raw = $input.first().json;\nconst parsed = raw.body ? raw : (raw.output || {});\nconst body = String(parsed.body || raw.text || '').trim();\nconst subject = String(parsed.subject || request.subject || '').trim();\nreturn [{\n  json: {\n    to: request.to,\n    subject,\n    body,\n    purpose: request.purpose,\n    requester: request.requester,\n    approvalMessage: 'Send this email?\\nTo: ' + request.to + '\\nSubject: ' + subject + '\\nRequested by: ' + request.requester\n      + '\\nPurpose: ' + request.purpose + '\\n\\n' + body,\n  },\n}];\n"
      },
      "id": "296b8d13-bcc6-40d6-a772-6b0989805e3c",
      "name": "Assemble Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        140
      ]
    },
    {
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').item.json.slackChannel }}"
        },
        "subject": "={{ 'Send email to ' + $json.to + '?' }}",
        "message": "={{ $json.approvalMessage }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
