            "approveLabel": "Send email",
            "buttonApprovalStyle": "primary",
            "disapproveLabel": "Discard",
            "buttonDisapprovalStyle": "secondary"
          }
        },
        "options": {}
      },
      "id": "e266bc1a-bc11-4a51-aa25-08552a13d51b",
      "name": "Wait For Approval",
