{
  "name": "Approval before sending email",
  "nodes": [
    {
      "parameters": {
        "content": "## Approval before send\n\nThe webhook returns immediately. Slack Message, Send and Wait for Response, posts Approve and Discard buttons.\n\nOnly the approved branch uses Gmail Send. Discard posts a note and does not send.\n\nSet slackChannel in Config. The workflow must be active for the buttons to resume it.",
        "width": 440,
        "height": 280,
        "color": 4
      },
      "id": "08a6770c-6358-47cc-bb1b-c8c01fc568ac",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-approval",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "7a1323dd-fee8-4afc-bc1d-741d9deda9f9",
      "name": "Draft Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        280
      ],
      "webhookId": "08f7289a-4956-464b-9b66-fee7c65b0f5b"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "af5fa29e-94f1-4a01-b1b9-356fa272f18c",
              "name": "slackChannel",
              "value": "email-approvals",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "25895e92-7f46-43db-af43-b3150cc4d603",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst to = String(body.to || '').trim();\nconst validTo = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(to);\nreturn [{\n  json: {\n    to,\n    validTo,\n    subject: String(body.subject || '').slice(0, 200),\n    purpose: String(body.purpose || '').slice(0, 500),\n    context: String(body.context || '').slice(0, 8000),\n    requester: String(body.requester || 'unknown').slice(0, 120),\n  },\n}];\n"
      },
      "id": "2899fdaa-8d9c-451e-8ae4-309a8e96f44d",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ecad1add-1ffd-4e5f-bcab-2736ec5a0f35",
              "leftValue": "={{ $json.validTo }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "86e7a855-bba0-4ce4-bbb3-1103a7caab3e",
      "name": "Recipient looks valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        280
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Draft the email a colleague asked for. Write a clear subject and a plain-text body. Use only facts from the purpose and the context. Do not promise refunds, discounts, or legal outcomes that were not provided. Do not include a signature.\n\nTo: {{ $json.to }}\nRequested subject: {{ $json.subject }}\nPurpose: {{ $json.purpose }}\nContext:\n{{ $json.context }}",
        "hasOutputParser": true
      },
      "id": "4c0db45f-7a21-4ce7-8823-bfb1e9e068c0",
      "name": "Draft Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1000,
        140
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
