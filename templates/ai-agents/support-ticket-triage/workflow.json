      "id": "9e236ccc-52e8-4158-a674-563e6e1b825a",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        280,
        280
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const raw = item.json.body && typeof item.json.body === 'object' ? item.json.body : item.json;\n  const subject = String(raw.subject || raw.title || 'No subject').slice(0, 300);\n  const body = String(raw.body || raw.description || raw.message || '').slice(0, 8000);\n  const requesterEmail = String(raw.requesterEmail || raw.email || raw.from || '');\n  const ticketId = String(raw.ticketId || raw.id || $execution.id);\n  results.push({ json: { ticketId, requesterEmail, subject, body, receivedAt: new Date().toISOString() } });\n}\nreturn results;\n"
      },
      "id": "fe9fcfeb-ebf2-4987-865d-6467b3d4d781",
      "name": "Normalize Ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        280
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Classify this support ticket. Use only these categories: billing, technical, account, general. Use only these priorities: low, normal, high, urgent. Pick the team that should own it (billing, technical, account, or general). needsHuman is true when the customer is angry, asks for a supervisor, reports a charge they do not recognize, or the request is ambiguous.\n\nTicket id: {{ $json.ticketId }}\nFrom: {{ $json.requesterEmail }}\nSubject: {{ $json.subject }}\nBody:\n{{ $json.body }}",
        "hasOutputParser": true
      },
      "id": "2f56aab4-8fb1-4382-89af-2da2480eeae7",
      "name": "Classify Ticket",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        760,
        280
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "e60e58af-2400-4ebb-90ef-37299e1e075e",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        760,
        500
      ]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"category\": \"billing\",\n  \"priority\": \"high\",\n  \"team\": \"billing\",\n  \"summary\": \"Customer was charged twice for the April invoice.\",\n  \"needsHuman\": true\n}"
      },
      "id": "20524b18-4004-40fc-8a3f-eddd668e402b",
      "name": "Triage Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        980,
        500
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const allowedCategories = ['billing', 'technical', 'account', 'general'];\nconst allowedPriorities = ['low', 'normal', 'high', 'urgent'];\nconst ticket = $('Normalize Ticket').first().json;\nconst raw = $input.first().json;\nconst parsed = raw.category ? raw : (raw.output || {});\nconst category = allowedCategories.includes(String(parsed.category || '').toLowerCase())\n  ? String(parsed.category).toLowerCase()\n  : 'general';\nconst priority = allowedPriorities.includes(String(parsed.priority || '').toLowerCase())\n  ? String(parsed.priority).toLowerCase()\n  : 'normal';\nconst team = allowedCategories.includes(String(parsed.team || '').toLowerCase())\n  ? String(parsed.team).toLowerCase()\n  : category;\nreturn [{\n  json: {\n    ...ticket,\n    category,\n    priority,\n    team,\n    summary: String(parsed.summary || ticket.subject).slice(0, 500),\n    needsHuman: parsed.needsHuman === true,\n  },\n}];\n"
      },
