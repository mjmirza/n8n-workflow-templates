      "id": "fc9869b6-5318-4709-881c-a0876cf24572",
      "name": "Read Reviews",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        480,
        320
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = [];\nfor (const item of $input.all()) {\n  const review = String(item.json.ReviewText || item.json.reviewText || '').trim();\n  const sentiment = String(item.json.Sentiment || item.json.sentiment || '').trim();\n  const reviewId = String(item.json.ReviewId || item.json.reviewId || '').trim();\n  if (!review || !reviewId || sentiment) continue;\n  rows.push({\n    json: {\n      ReviewId: reviewId,\n      Product: String(item.json.Product || item.json.product || ''),\n      ReviewText: review.slice(0, 4000),\n    },\n  });\n  if (rows.length >= 25) break;\n}\nreturn rows;\n"
      },
      "id": "b15852f3-0269-45cb-a11e-e0867cc64999",
      "name": "Unscored Reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
