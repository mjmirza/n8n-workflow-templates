              "value": "ActionItems",
              "type": "string"
            },
            {
              "id": "c75b66ce-687b-4b8f-8840-40ae376ee5a7",
              "name": "slackChannel",
              "value": "meeting-actions",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a241ccd2-8451-46bf-b633-5f8942a00382",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        280
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const raw = item.json.body && typeof item.json.body === 'object' ? item.json.body : item.json;\n  const attendees = Array.isArray(raw.attendees) ? raw.attendees.join(', ') : String(raw.attendees || '');\n  results.push({\n    json: {\n      title: String(raw.title || 'Untitled meeting').slice(0, 200),\n      attendees,\n      transcript: String(raw.transcript || raw.text || '').slice(0, 24000),\n    },\n  });\n}\nreturn results;\n"
      },
      "id": "c8b3ea52-84d2-49e1-b80e-76989ce67fe2",
      "name": "Normalize Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        280
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Turn this meeting transcript into a short summary, the decisions that were actually agreed, and concrete action items. Do not assign an owner who was not in the transcript or the attendee list. If no due date was stated, leave dueDate empty. priority is low, normal, or high.\n\nTitle: {{ $json.title }}\nAttendees: {{ $json.attendees }}\n\nTranscript:\n{{ $json.transcript }}",
        "hasOutputParser": true
      },
      "id": "e9c625e4-094c-4249-a2a1-ed1920119449",
      "name": "Extract Actions",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        720,
        280
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "37848911-c18e-42c4-a39c-6a500d186efd",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        720,
        520
      ]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"summary\": \"The team agreed to ship the billing fix this week.\",\n  \"decisions\": [\n    \"Ship the tax fix on Thursday\"\n  ],\n  \"actionItems\": [\n    {\n      \"task\": \"Send the revised quote\",\n      \"owner\": \"Amina\",\n      \"dueDate\": \"2026-11-28\",\n      \"priority\": \"high\"\n    }\n  ]\n}"
      },
      "id": "5455ce14-6f49-4e02-a351-c6e6fd94e612",
      "name": "Action Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        960,
        520
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const meeting = $('Normalize Transcript').first().json;\nconst raw = $input.first().json;\nconst parsed = raw.summary ? raw : (raw.output || {});\nconst decisions = Array.isArray(parsed.decisions) ? parsed.decisions.map((item) => String(item)) : [];\nlet actions = Array.isArray(parsed.actionItems) ? parsed.actionItems : [];\nactions = actions.map((item) => ({\n  task: String(item.task || '').slice(0, 400),\n  owner: String(item.owner || 'unassigned').slice(0, 120),\n  dueDate: String(item.dueDate || ''),\n  priority: ['low', 'normal', 'high'].includes(String(item.priority || '').toLowerCase())\n    ? String(item.priority).toLowerCase()\n    : 'normal',\n}));\nif (!actions.length) {\n  actions = [{ task: '', owner: '', dueDate: '', priority: '', note: 'No action items' }];\n}\nconst slackText = '*' + meeting.title + '*\\n'\n  + (meeting.attendees ? 'Attendees: ' + meeting.attendees + '\\n' : '')\n  + '\\n' + String(parsed.summary || '')\n  + '\\n\\n*Decisions*\\n' + (decisions.length ? decisions.map((d) => '- ' + d).join('\\n') : '- none')\n  + '\\n\\n*Action items*\\n' + actions.filter((a) => a.task).map((a) => '- ' + a.task + ' (' + a.owner + (a.dueDate ? ', due ' + a.dueDate : '') + ')').join('\\n');\nreturn [{\n  json: {\n    title: meeting.title,\n    attendees: meeting.attendees,\n    summary: String(parsed.summary || ''),\n    decisions,\n    actionItems: actions,\n    slackText: slackText || meeting.title,\n  },\n}];\n"
      },
      "id": "1e7e02d7-9ab5-46df-8f72-1a3e5da64569",
      "name": "Package Meeting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
