      "typeVersion": 2,
      "position": [
        0,
        280
      ],
      "webhookId": "28b9b9b6-726d-42bf-a456-87115ef3e2f6"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a24d8946-3630-4cd0-b1b3-ca77abf62984",
              "name": "spreadsheetId",
              "value": "",
              "type": "string"
            },
            {
              "id": "374e7a79-bca9-4fb7-b034-afebe0953366",
