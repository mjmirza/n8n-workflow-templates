              "id": "2504d6d3-50f3-4c44-be6a-a5ad6ce518ba",
              "leftValue": "={{ $json.invoiceText }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
