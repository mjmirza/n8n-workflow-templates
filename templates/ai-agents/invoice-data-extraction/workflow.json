      "id": "edebd274-eabc-4f3d-b5a8-0fe3d674e146",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        980,
        460
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "function num(value) {\n  if (typeof value === 'number') return value;\n  const cleaned = String(value == null ? '' : value).replace(/[^0-9.-]/g, '');\n  if (!cleaned) return null;\n  const parsed = Number(cleaned);\n  return Number.isFinite(parsed) ? parsed : null;\n}\nconst raw = $input.first().json;\nconst extracted = raw.vendor_name ? raw : (raw.output || raw);\nconst subtotal = num(extracted.subtotal);\nconst tax = num(extracted.tax);\nconst total = num(extracted.total);\nconst issues = [];\nif (!extracted.vendor_name) issues.push('missing vendor_name');\nif (!extracted.invoice_number) issues.push('missing invoice_number');\nif (total == null) issues.push('missing total');\nif (subtotal != null && tax != null && total != null) {\n  const delta = Math.abs((subtotal + tax) - total);\n  if (delta > 0.05) issues.push('subtotal plus tax differs from total by ' + delta.toFixed(2));\n}\nconst source = $('Normalize Invoice').first().json;\nreturn [{\n  json: {\n    vendor_name: String(extracted.vendor_name || ''),\n    invoice_number: String(extracted.invoice_number || ''),\n    invoice_date: String(extracted.invoice_date || ''),\n    due_date: String(extracted.due_date || ''),\n    currency: String(extracted.currency || ''),\n    subtotal,\n    tax,\n    total,\n    line_items_summary: String(extracted.line_items_summary || ''),\n    valid: issues.length === 0,\n    issues,\n    sourceName: source.sourceName,\n  },\n}];\n"
      },
