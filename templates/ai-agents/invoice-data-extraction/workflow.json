    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst invoiceText = String(body.invoiceText || body.text || body.body || '').slice(0, 20000);\nreturn [{ json: { invoiceText, sourceName: String(body.sourceName || body.filename || '') } }];\n"
      },
