      "id": "e39f54ad-0e37-4c52-9d1f-cfc9adb28e77",
      "name": "Extract Article",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        980,
        140
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst title = String(item.title || '').trim();\nconst article = String(item.article || '').trim();\nconst body = String(item.body || '').trim();\nconst text = (article || body || String(item.data || item.html || '')).replace(/\\s+/g, ' ').trim().slice(0, 12000);\nconst sourceUrl = String($('Config').first().json.url || '');\nreturn [{ json: { title, text, sourceUrl, hasText: text.length > 80 } }];\n"
      },
      "id": "12f40c5b-db16-490b-8c13-74c35704b917",
      "name": "Clean From Fetch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        140
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst html = String(raw.html || raw.text || '');\nconst text = html.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ').replace(/<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 12000);\nreturn [{ json: { title: String(raw.title || ''), text, sourceUrl: String(raw.url || ''), hasText: text.length > 80 } }];\n"
      },
      "id": "28f62b1d-bb30-42e8-8a5f-45b500c37ad4",
