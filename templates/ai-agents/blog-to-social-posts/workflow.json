      },
      "id": "d14e00e5-5908-4e57-a6ce-8d72b15be90f",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1700,
        420
      ]
    },
    {
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"title\": \"Why onboarding stalls on day two\",\n  \"linkedin\": \"Most onboarding checklists die after the first login. Here is the day-two email we send instead.\",\n  \"x\": \"Day-two onboarding mail outperforms another product tour. Send one job, not twelve links.\",\n  \"newsletter\": \"Teams that send one specific day-two task keep more trials than teams that send a tour.\",\n  \"hashtags\": [\n    \"onboarding\",\n    \"saas\"\n  ]\n}"
      },
      "id": "53bf3028-321f-4368-970f-4b744e3007b7",
      "name": "Post Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1940,
        420
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst parsed = raw.linkedin ? raw : (raw.output || {});\nlet x = String(parsed.x || '').trim();\nif (x.length > 280) {\n  x = x.slice(0, 277).replace(/\\s+\\S*$/, '') + '...';\n}\nconst hashtags = Array.isArray(parsed.hashtags) ? parsed.hashtags.map((tag) => String(tag).replace(/^#/, '')) : [];\nconst source = $('Clean Article').first().json;\nreturn [{\n  json: {\n    sourceUrl: source.sourceUrl,\n    title: String(parsed.title || source.title || ''),\n    linkedin: String(parsed.linkedin || '').trim(),\n    x,\n    xLength: x.length,\n    newsletter: String(parsed.newsletter || '').trim(),\n    hashtags,\n    slackText: '*Social variants*\\n' + (source.sourceUrl ? source.sourceUrl + '\\n\\n' : '\\n')\n      + '*LinkedIn*\\n' + String(parsed.linkedin || '') + '\\n\\n'\n      + '*X* (' + x.length + ')\\n' + x + '\\n\\n'\n      + '*Newsletter*\\n' + String(parsed.newsletter || '') + '\\n\\n'\n      + (hashtags.length ? '#' + hashtags.join(' #') : ''),\n  },\n}];\n"
      },
