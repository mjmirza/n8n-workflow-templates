    {
      "parameters": {
        "promptType": "define",
        "text": "=Repurpose this article into three ready-to-edit posts. Do not add claims that are not in the article. LinkedIn: 80 to 140 words, first line is the hook. X: one post, must stay under 280 characters. Newsletter: two sentences. Hashtags: up to 4 short topic tags without the hash mark.\n\nTitle: {{ $json.title }}\nSource: {{ $json.sourceUrl }}\n\n{{ $json.text }}",
        "hasOutputParser": true
      },
      "id": "fed61423-653b-40f9-b874-8860986e9162",
      "name": "Write Social Posts",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1700,
        160
      ]
    },
