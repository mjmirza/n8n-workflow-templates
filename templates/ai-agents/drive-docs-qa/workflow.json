        "path": "drive-docs-qa",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2ff909da-fbb0-4410-9269-a0f66cbd2be4",
      "name": "Question Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "c437afeb-b89c-43a2-b0ea-7902a8440f37"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "2b21f1f6-2635-4fad-bd9d-6ccf81221a8d",
