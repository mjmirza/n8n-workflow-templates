      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "query",
        "queryString": "={{ \"'\" + $('Config').item.json.folderId + \"' in parents and mimeType = 'application/vnd.google-apps.document' and trashed = false\" }}",
