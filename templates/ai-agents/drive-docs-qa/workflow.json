            }
          }
        }
      },
      "id": "33ddb265-5b0e-45a9-846d-08d4d9fb95f3",
      "name": "Download Doc",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        980,
        180
      ]
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "options": {}
      },
      "id": "9a415847-1df8-4acb-950b-25f84edee1fd",
      "name": "Extract Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1200,
        180
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const question = String($('Config').first().json.question || '').trim();\nconst maxChars = Number($('Config').first().json.maxContextChars) || 8000;\nconst stop = new Set(['the','and','for','with','that','this','from','your','what','how','why','are','was','were','you','can','about','have','has','not','but','its','into','our']);\nconst terms = question.toLowerCase().split(/[^a-z0-9]+/).filter((word) => word.length > 2 && !stop.has(word));\nconst docs = $input.all();\nconst searched = $('Search Docs').all();\nconst chunks = [];\n\ndocs.forEach((item, index) => {\n  const text = String(item.json.data || item.json.text || '');\n  const fileName = (searched[index] && searched[index].json && searched[index].json.name) || ('document-' + (index + 1));\n  const parts = text.split(/\\n\\s*\\n/).map((part) => part.trim()).filter((part) => part.length > 40);\n  const sourceParts = parts.length ? parts : (text.trim() ? [text.trim()] : []);\n  sourceParts.forEach((part) => {\n    const words = new Set(part.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean));\n    let score = 0;\n    for (const term of terms) {\n      if (words.has(term)) score += 1;\n    }\n    chunks.push({ fileName, score, text: part.slice(0, 1500) });\n  });\n});\n\nchunks.sort((a, b) => b.score - a.score);\nconst picked = [];\nlet used = 0;\nfor (const chunk of chunks) {\n  if (picked.length >= 6) break;\n  if (chunk.score === 0 && picked.length >= 2) continue;\n  if (used + chunk.text.length > maxChars) continue;\n  picked.push(chunk);\n  used += chunk.text.length;\n}\nif (!picked.length && chunks[0]) picked.push(chunks[0]);\n\nconst context = picked.map((chunk, index) => '[' + (index + 1) + '] ' + chunk.fileName + '\\n' + chunk.text).join('\\n\\n');\nconst sources = [];\nfor (const chunk of picked) {\n  if (!sources.includes(chunk.fileName)) sources.push(chunk.fileName);\n}\nreturn [{ json: { question, context, sources, chunkCount: picked.length } }];\n"
      },
      "id": "6ac3b3d2-944a-4a60-9ccc-3b88119035c4",
      "name": "Retrieve Passages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        180
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Answer the question using only the context passages. If the passages do not contain the answer, say you do not know. Cite the file name for each claim you use. Do not use outside knowledge.\n\nQuestion:\n{{ $json.question }}\n\nContext:\n{{ $json.context }}"
      },
      "id": "63652260-5432-45a5-815f-ad2db5ffdbc7",
      "name": "Answer From Context",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1680,
        180
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "46003cea-2736-475d-ac21-7396e2835d33",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1680,
        420
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const retrieved = $('Retrieve Passages').first().json;\nconst raw = $input.first().json;\nconst answer = typeof raw.text === 'string' ? raw.text : (typeof raw.output === 'string' ? raw.output : JSON.stringify(raw));\nreturn [{\n  json: {\n    question: retrieved.question,\n    answer,\n    sources: retrieved.sources || [],\n    chunkCount: retrieved.chunkCount || 0,\n  },\n}];\n"
      },
      "id": "180be18f-fbc4-4909-863f-aa2179715320",
      "name": "Package Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
