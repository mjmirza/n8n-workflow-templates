              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9a784631-4374-4b03-891e-c15ff7b28552",
      "name": "Docs found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
