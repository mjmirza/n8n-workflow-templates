    {
      "id": "397904c7-0708-4d10-b312-9400bcf9af9b",
      "name": "Prepare Invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        80
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const deal = $('Normalize Deal').item.json;\nconst person = $json;\nconst emails = Array.isArray(person.email) ? person.email : [];\nconst primary = emails.find((entry) => entry && entry.primary && entry.value) || emails.find((entry) => entry && entry.value) || {};\nconst email = String(primary.value || '').trim().toLowerCase();\nconst zeroDecimal = new Set(['bif', 'clp', 'djf', 'gnf', 'jpy', 'kmf', 'krw', 'mga', 'pyg', 'rwf', 'ugx', 'vnd', 'vuv', 'xaf', 'xof', 'xpf']);\nconst currency = String(deal.currency || 'usd').toLowerCase();\nconst amountMajor = Number(deal.value || 0);\nconst amountCents = zeroDecimal.has(currency) ? Math.round(amountMajor) : Math.round(amountMajor * 100);\nreturn [{\n  json: {\n    ...deal,\n    email,\n    personName: person.name || deal.personName || email,\n    amountMajor,\n    amountCents,\n    currency,\n    description: 'Pipedrive deal ' + deal.dealId + ': ' + deal.title,\n  },\n}];"
      }
    },
