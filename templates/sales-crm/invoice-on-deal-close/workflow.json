    {
      "id": "e1a2c3f1-49d7-43c4-9eb1-dde7f4344662",
      "name": "Normalize Deal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        320
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst current = body.current || {};\nconst previous = body.previous || {};\nconst meta = body.meta || {};\nconst idOf = (value) => {\n  if (value === null || value === undefined || value === '') return null;\n  if (typeof value === 'object') return value.value || value.id || null;\n  return value;\n};\nreturn [{\n  json: {\n    dealId: idOf(current.id) || idOf(meta.id),\n    title: current.title || '',\n    status: current.status || '',\n    previousStatus: previous.status || '',\n    value: Number(current.value || 0),\n    currency: String(current.currency || 'USD'),\n    personId: idOf(current.person_id),\n    personName: current.person_name || '',\n    orgName: current.org_name || '',\n    ownerName: current.owner_name || '',\n    stageId: idOf(current.stage_id),\n  },\n}];"
      }
    },
