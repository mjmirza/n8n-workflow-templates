        },
        "options": {}
      }
    },
    {
      "id": "392c36a9-b4a5-4ae8-aeee-5ced612c3e98",
      "name": "Expand Deals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
