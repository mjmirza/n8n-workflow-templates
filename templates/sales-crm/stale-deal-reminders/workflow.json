      "typeVersion": 3.4,
      "position": [
        280,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "e34ee601-e754-4bde-bbb7-0bbc6ed84f28",
              "name": "slackChannel",
              "value": "#sales-pipeline",
              "type": "string"
            },
            {
              "id": "5735436d-41e4-4be6-a036-0692864b1e7e",
              "name": "staleDays",
              "value": 14,
              "type": "number"
            },
            {
              "id": "e2412d8b-552b-43b4-a6ff-35a5e761dd61",
              "name": "createTasks",
              "value": false,
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "ea7a4b96-4a5b-46f6-84fd-d64297f18ffc",
      "name": "Get Open Deals",
      "type": "n8n-nodes-base.pipedrive",
      "typeVersion": 1,
      "position": [
        540,
        300
      ],
      "parameters": {
        "authentication": "apiToken",
        "resource": "deal",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "status": "open"
        }
      },
      "credentials": {
        "pipedriveApi": {
          "id": null,
          "name": "Pipedrive account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "fa756470-ecfc-405a-a187-3b3ab5036a1c",
      "name": "Find Stale Deals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const settings = $('Settings').first().json;\nconst staleDays = Number(settings.staleDays || 14);\nconst cutoff = Date.now() - staleDays * 24 * 60 * 60 * 1000;\nconst deals = $input.all().map((item) => item.json).filter((deal) => deal && deal.id);\nconst stale = [];\nfor (const deal of deals) {\n  const updated = Date.parse(deal.update_time || deal.add_time || '');\n  if (!Number.isFinite(updated) || updated > cutoff) continue;\n  stale.push({\n    id: deal.id,\n    title: deal.title || ('Deal ' + deal.id),\n    value: deal.value || 0,\n    currency: deal.currency || '',\n    owner: deal.owner_name || 'Unassigned',\n    org: deal.org_name || '',\n    person: deal.person_name || '',\n    ageDays: Math.floor((Date.now() - updated) / 86400000),\n  });\n}\nstale.sort((a, b) => b.ageDays - a.ageDays);\nconst byOwner = new Map();\nfor (const deal of stale) {\n  if (!byOwner.has(deal.owner)) byOwner.set(deal.owner, []);\n  byOwner.get(deal.owner).push(deal);\n}\nconst sections = [];\nfor (const [owner, rows] of byOwner) {\n  const lines = rows.slice(0, 8).map((deal) => '\u2022 ' + deal.title + ' (' + deal.currency + ' ' + deal.value + ') \u2014 ' + deal.ageDays + 'd idle' + (deal.org ? ' \u00b7 ' + deal.org : ''));\n  const extra = rows.length > 8 ? '\\n\u2022 +' + (rows.length - 8) + ' more' : '';\n  sections.push('*' + owner + '* (' + rows.length + ')\\n' + lines.join('\\n') + extra);\n}\nreturn [{\n  json: {\n    staleCount: stale.length,\n    openDealCount: deals.length,\n    slackText: stale.length ? '*Stale open deals* \u2014 no update in ' + staleDays + '+ days (' + stale.length + ' of ' + deals.length + ')\\n\\n' + sections.join('\\n\\n') : '',\n    deals: stale,\n    createTasks: settings.createTasks === true,\n  },\n}];"
      }
    },
    {
      "id": "78502313-1992-4005-bfa6-c2c87d98635c",
      "name": "Any Stale?",
      "type": "n8n-nodes-base.if",
