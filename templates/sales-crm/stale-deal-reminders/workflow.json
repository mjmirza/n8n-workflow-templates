{
  "name": "Stale Pipedrive deal reminders",
  "nodes": [
    {
      "id": "1db6bcef-fc30-4b42-8c39-df54a456bb5e",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        40
      ],
      "parameters": {
        "content": "## Stale deals\n\nWeekday 09:00. Open Pipedrive deals with no update in staleDays (default 14) are grouped by owner and posted to Slack.\n\ncreateTasks is false. Turn it on only if you want a Pipedrive task on every stale deal each weekday.",
        "height": 240,
        "width": 380,
        "color": 4
      }
    },
    {
      "id": "17204667-f3b7-4e81-9228-720c6ba5fcfb",
      "name": "Weekday Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                1,
                2,
                3,
                4,
                5
              ],
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "74419a1c-c84b-4304-8ffc-c271ca17c8c5",
