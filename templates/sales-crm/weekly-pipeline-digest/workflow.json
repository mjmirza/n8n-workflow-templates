    {
      "id": "55f2d2d8-9702-401a-84ee-1b3ee79cbbf8",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const settings = $('Settings').first().json;\nconst staleDays = Number(settings.staleDays || 14);\nconst cutoff = Date.now() - staleDays * 24 * 60 * 60 * 1000;\nconst stageRows = $('Get Stages').first().json.data || [];\nconst stageName = {};\nfor (const stage of stageRows) stageName[stage.id] = stage.name || ('Stage ' + stage.id);\nconst deals = ($('Collect Deals').first().json.deals || []).filter((deal) => deal && deal.id);\nconst groups = new Map();\nlet staleCount = 0;\nconst byCurrency = {};\nfor (const deal of deals) {\n  const stage = stageName[deal.stage_id] || ('Stage ' + (deal.stage_id || '?'));\n  if (!groups.has(stage)) groups.set(stage, { count: 0, value: 0, currency: deal.currency || '' });\n  const bucket = groups.get(stage);\n  bucket.count += 1;\n  bucket.value += Number(deal.value || 0);\n  const currency = deal.currency || 'USD';\n  byCurrency[currency] = (byCurrency[currency] || 0) + Number(deal.value || 0);\n  const updated = Date.parse(deal.update_time || deal.add_time || '');\n  if (Number.isFinite(updated) && updated <= cutoff) staleCount += 1;\n}\nconst top = deals\n  .slice()\n  .sort((a, b) => Number(b.value || 0) - Number(a.value || 0))\n  .slice(0, 5);\nconst money = Object.entries(byCurrency).map(([currency, value]) => currency + ' ' + value).join(', ') || '0';\nconst stageLines = [...groups.entries()].sort((a, b) => b[1].value - a[1].value);\nconst stageText = stageLines.map(([name, bucket]) => '\u2022 ' + name + ': ' + bucket.count + ' \u00b7 ' + bucket.value).join('\\n');\nconst slackText = '*Weekly pipeline* ' + deals.length + ' open deal(s) \u00b7 ' + money + '\\nIdle ' + staleDays + '+ days: ' + staleCount + '\\n' + stageText;\nconst html = [\n  '<h2>Weekly pipeline</h2>',\n  '<p>' + deals.length + ' open deal(s). Value by currency: ' + money + '.</p>',\n  '<p>Deals with no update in ' + staleDays + '+ days: <strong>' + staleCount + '</strong>.</p>',\n  '<h3>By stage</h3><ul>',\n  stageLines.map(([name, bucket]) => '<li>' + name + ': ' + bucket.count + ' deal(s), ' + bucket.value + '</li>').join(''),\n  '</ul><h3>Largest open deals</h3><ol>',\n  top.map((deal) => '<li>' + (deal.title || deal.id) + ' \u2014 ' + (deal.currency || '') + ' ' + (deal.value || 0) + ' \u00b7 ' + (deal.owner_name || 'unassigned') + '</li>').join(''),\n  '</ol>',\n].join('');\nreturn [{\n  json: {\n    slackText,\n    html,\n    subject: 'Pipeline digest: ' + deals.length + ' open, ' + staleCount + ' idle',\n    to: settings.digestEmail,\n  },\n}];"
      }
    },
