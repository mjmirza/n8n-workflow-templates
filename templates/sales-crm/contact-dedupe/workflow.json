    {
      "id": "9dae0941-8e01-40f5-8659-ecf293824a9c",
      "name": "Normalize Contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const sourceItem = $('Contact Webhook').first().json;\nconst raw = sourceItem.body && typeof sourceItem.body === 'object' ? sourceItem.body : sourceItem;\nconst pick = (...keys) => {\n  for (const key of keys) {\n    const value = raw[key];\n    if (value !== undefined && value !== null && String(value).trim() !== '') {\n      return String(value).trim();\n    }\n  }\n  return '';\n};\nlet firstName = pick('firstName', 'first_name', 'firstname');\nlet lastName = pick('lastName', 'last_name', 'lastname');\nconst fullName = pick('fullName', 'full_name', 'name');\nif (!firstName && fullName) {\n  const parts = fullName.split(/\\s+/).filter(Boolean);\n  firstName = parts.shift() || '';\n  lastName = lastName || parts.join(' ');\n}\nreturn [{\n  json: {\n    email: pick('email', 'Email', 'workEmail').toLowerCase(),\n    firstName,\n    lastName,\n    fullName: fullName || [firstName, lastName].filter(Boolean).join(' '),\n    company: pick('company', 'companyName', 'company_name', 'organization'),\n    jobTitle: pick('jobTitle', 'job_title', 'title'),\n    phone: pick('phone', 'phoneNumber', 'phone_number'),\n    website: pick('website', 'websiteUrl', 'companyWebsite'),\n    source: pick('source', 'utm_source', 'leadSource') || 'webhook',\n    pageUrl: pick('pageUrl', 'page_url', 'landingPage'),\n    message: pick('message', 'notes', 'comments'),\n    employeeCount: pick('employeeCount', 'employees', 'companySize'),\n    annualRevenue: pick('annualRevenue', 'revenue'),\n    receivedAt: new Date().toISOString(),\n  },\n}];"
      }
    },
    {
      "id": "c7fd2fa0-ed68-4385-870f-961e647776ac",
      "name": "Valid Email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        780,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "42d7e5e2-c0ed-41a7-b395-aa30502f679b",
              "leftValue": "={{ $json.email }}",
              "rightValue": "@",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3ded97e7-3dfd-4eee-af89-1404c75515c2",
      "name": "Search HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1040,
        180
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "options": {},
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: \"email\", operator: \"EQ\", value: $json.email }] }], properties: [\"email\", \"firstname\", \"lastname\", \"company\", \"phone\", \"jobtitle\", \"website\"], limit: 5 }) }}"
      },
      "credentials": {
        "hubspotAppToken": {
          "id": null,
          "name": "HubSpot account"
        }
      }
    },
    {
      "id": "419fad89-ca9d-499c-b0a8-45b05103b0e4",
      "name": "Decide Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const incoming = $('Normalize Contact').first().json;\nconst results = Array.isArray($json.results) ? $json.results : [];\nconst existing = results[0];\nif (!existing) {\n  return [{ json: { ...incoming, action: 'create', reason: 'No HubSpot contact with this email', hubspotId: '', changes: '' } }];\n}\nconst props = existing.properties || {};\nconst pairs = [\n  ['firstName', 'firstname'],\n  ['lastName', 'lastname'],\n  ['company', 'company'],\n  ['jobTitle', 'jobtitle'],\n  ['phone', 'phone'],\n  ['website', 'website'],\n];\nconst changes = [];\nfor (const [field, propertyName] of pairs) {\n  const next = String(incoming[field] || '').trim();\n  const prev = String(props[propertyName] || '').trim();\n  if (next && next.toLowerCase() !== prev.toLowerCase()) {\n    changes.push(field + ': ' + (prev || '\u2205') + ' \u2192 ' + next);\n  }\n}\nif (changes.length === 0) {\n  return [{ json: { ...incoming, action: 'skip', reason: 'Contact exists and incoming fields match', hubspotId: existing.id, changes: '' } }];\n}\nreturn [{ json: { ...incoming, action: 'update', reason: 'Incoming values differ', hubspotId: existing.id, changes: changes.join('; ') } }];"
      }
    },
