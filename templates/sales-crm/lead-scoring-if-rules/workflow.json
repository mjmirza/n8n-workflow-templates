    {
      "id": "1752a940-889a-43a0-9693-94f0d522b2b9",
      "name": "Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        180
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const lead = $input.first().json;\nconst reasons = [];\nlet score = 0;\nconst title = String(lead.jobTitle || '').toLowerCase();\nif (/\\b(chief|ceo|cto|cfo|coo|cmo|founder|owner|partner)\\b/.test(title)) {\n  score += 35;\n  reasons.push('Executive title +35');\n} else if (/\\b(vp|vice president|head|director)\\b/.test(title)) {\n  score += 25;\n  reasons.push('Director or VP title +25');\n} else if (/\\b(manager|lead)\\b/.test(title)) {\n  score += 10;\n  reasons.push('Manager title +10');\n}\nconst employees = Number(lead.employeeCount || 0);\nif (employees >= 1000) {\n  score += 25;\n  reasons.push('1000+ employees +25');\n} else if (employees >= 200) {\n  score += 20;\n  reasons.push('200+ employees +20');\n} else if (employees >= 50) {\n  score += 12;\n  reasons.push('50+ employees +12');\n} else if (employees > 0) {\n  score += 4;\n  reasons.push('Company size provided +4');\n}\nconst revenue = Number(lead.annualRevenue || 0);\nif (revenue >= 10000000) {\n  score += 20;\n  reasons.push('Revenue 10M+ +20');\n} else if (revenue >= 1000000) {\n  score += 12;\n  reasons.push('Revenue 1M+ +12');\n}\nconst source = String(lead.source || '').toLowerCase();\nif (['referral', 'partner', 'customer'].includes(source)) {\n  score += 20;\n  reasons.push('High-intent source +20');\n} else if (['webinar', 'demo', 'event'].includes(source)) {\n  score += 12;\n  reasons.push('Engaged source +12');\n} else if (['paid', 'ads', 'linkedin'].includes(source)) {\n  score += 6;\n  reasons.push('Paid or social source +6');\n}\nif (String(lead.website || '').trim()) {\n  score += 5;\n  reasons.push('Company website present +5');\n}\nif (String(lead.phone || '').trim()) {\n  score += 5;\n  reasons.push('Phone present +5');\n}\nconst freeDomains = ['gmail.com', 'googlemail.com', 'yahoo.com', 'yahoo.co.uk', 'outlook.com', 'hotmail.com', 'live.com', 'icloud.com', 'aol.com', 'proton.me', 'protonmail.com', 'gmx.com', 'me.com'];\nconst domain = String(lead.email.split('@')[1] || '').toLowerCase();\nif (freeDomains.includes(domain)) {\n  score -= 15;\n  reasons.push('Free email domain -15');\n}\nif (lead.message && /budget|timeline|pricing|purchase|evaluating/i.test(lead.message)) {\n  score += 10;\n  reasons.push('Buying language in the message +10');\n}\nscore = Math.max(0, Math.min(100, score));\nreturn [{ json: { ...lead, score, domain, reasons: reasons.join('; ') } }];"
      }
    },
