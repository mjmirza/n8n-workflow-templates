    {
      "id": "15b33398-b1a1-49d1-8d5c-885ed014eb5f",
      "name": "Normalize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        320
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const sourceItem = $('LinkedIn Webhook').first().json;\nconst raw = sourceItem.body && typeof sourceItem.body === 'object' ? sourceItem.body : sourceItem;\nconst pick = (...keys) => {\n  for (const key of keys) {\n    const value = raw[key];\n    if (value !== undefined && value !== null && String(value).trim() !== '') return String(value).trim();\n  }\n  return '';\n};\nlet firstName = pick('firstName', 'first_name', 'FirstName');\nlet lastName = pick('lastName', 'last_name', 'LastName');\nconst fullName = pick('fullName', 'name', 'Name');\nif (!firstName && fullName) {\n  const parts = fullName.split(/\\s+/).filter(Boolean);\n  firstName = parts.shift() || '';\n  lastName = lastName || parts.join(' ');\n}\nconst email = pick('email', 'emailAddress', 'Email', 'workEmail').toLowerCase();\nconst leadUrn = pick('leadGenFormResponse', 'leadGenFormResponseId');\nreturn [{\n  json: {\n    email,\n    firstName,\n    lastName,\n    fullName: fullName || [firstName, lastName].filter(Boolean).join(' '),\n    company: pick('company', 'companyName', 'Company'),\n    jobTitle: pick('jobTitle', 'title', 'Title'),\n    phone: pick('phone', 'phoneNumber', 'Phone'),\n    linkedinUrl: pick('linkedinUrl', 'linkedinProfile', 'profileUrl'),\n    formName: pick('formName', 'form'),\n    campaign: pick('campaignName', 'campaign'),\n    submittedAt: pick('submittedAt') || new Date().toISOString(),\n    leadUrn,\n    needsFetch: !email && !!leadUrn,\n  },\n}];"
      }
    },
