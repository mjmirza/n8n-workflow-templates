    {
      "id": "34ba44bd-d4ec-4fb0-9ab4-0fe7a7fc9f47",
      "name": "Map LinkedIn Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        160
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const prior = $('Normalize Lead').first().json;\nconst answers = (((($json.formResponse || {}).answers) || []));\nconst texts = [];\nfor (const answer of answers) {\n  const details = answer.answerDetails || {};\n  const text = details.textQuestionAnswer && details.textQuestionAnswer.answer;\n  if (text) texts.push(String(text).trim());\n}\nconst email = texts.find((text) => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(text)) || prior.email;\nconst name = texts.find((text) => text !== email && !text.includes('@')) || prior.fullName;\nconst parts = String(name || '').split(/\\s+/).filter(Boolean);\nconst campaign = (((($json.leadMetadata || {}).sponsoredLeadMetadata || {}).campaign || {}).name) || prior.campaign;\nreturn [{\n  json: {\n    ...prior,\n    email: String(email || '').toLowerCase(),\n    fullName: name || prior.fullName,\n    firstName: prior.firstName || parts[0] || '',\n    lastName: prior.lastName || parts.slice(1).join(' '),\n    campaign,\n    submittedAt: $json.submittedAt ? new Date($json.submittedAt).toISOString() : prior.submittedAt,\n    needsFetch: false,\n  },\n}];"
      }
    },
