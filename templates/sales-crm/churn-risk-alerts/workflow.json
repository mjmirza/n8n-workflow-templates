    {
      "id": "e6adf43d-1d2d-4851-bbab-676618d1a82a",
      "name": "Score Accounts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map((item) => item.json).filter((row) => row && row.email);\nconst now = Date.now();\nconst scored = [];\nfor (const row of rows) {\n  const reasons = [];\n  let score = 0;\n  const lastLogin = Date.parse(row.last_login_at || row.lastLoginAt || '');\n  const daysSinceLogin = Number.isFinite(lastLogin) ? Math.floor((now - lastLogin) / 86400000) : null;\n  if (daysSinceLogin === null) {\n    score += 15;\n    reasons.push('No usable last login +15');\n  } else if (daysSinceLogin >= 45) {\n    score += 40;\n    reasons.push('No login in ' + daysSinceLogin + 'd +40');\n  } else if (daysSinceLogin >= 21) {\n    score += 25;\n    reasons.push('No login in ' + daysSinceLogin + 'd +25');\n  } else if (daysSinceLogin >= 10) {\n    score += 10;\n    reasons.push('No login in ' + daysSinceLogin + 'd +10');\n  }\n  const nps = row.nps === '' || row.nps === undefined || row.nps === null ? null : Number(row.nps);\n  if (nps !== null && Number.isFinite(nps)) {\n    if (nps <= 6) {\n      score += 25;\n      reasons.push('NPS ' + nps + ' +25');\n    } else if (nps <= 8) {\n      score += 8;\n      reasons.push('NPS ' + nps + ' +8');\n    }\n  }\n  const tickets = Number(row.open_tickets || row.openTickets || 0);\n  if (tickets >= 5) {\n    score += 20;\n    reasons.push(tickets + ' open tickets +20');\n  } else if (tickets >= 2) {\n    score += 10;\n    reasons.push(tickets + ' open tickets +10');\n  }\n  const plan = String(row.plan || '').toLowerCase();\n  if (plan === 'monthly' && daysSinceLogin !== null && daysSinceLogin >= 21) {\n    score += 10;\n    reasons.push('Monthly plan and idle +10');\n  }\n  const mrr = Number(row.mrr || 0);\n  if (mrr >= 2000 && score >= 25) {\n    score += 10;\n    reasons.push('High MRR with other risk +10');\n  }\n  score = Math.max(0, Math.min(100, score));\n  let tier = 'low';\n  if (score >= 60) tier = 'high';\n  else if (score >= 35) tier = 'medium';\n  if (tier === 'low') continue;\n  scored.push({\n    email: String(row.email).trim().toLowerCase(),\n    company: row.company || '',\n    plan,\n    mrr,\n    ownerEmail: row.owner_email || row.ownerEmail || '',\n    daysSinceLogin: daysSinceLogin === null ? '' : daysSinceLogin,\n    score,\n    tier,\n    reasons: reasons.join('; '),\n    alertedAt: new Date().toISOString(),\n  });\n}\nscored.sort((a, b) => b.score - a.score);\nreturn scored.map((row) => ({ json: row }));"
      }
    },
