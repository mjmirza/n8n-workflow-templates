    {
      "id": "50741b7e-8004-4110-bc55-e37d1f3978cb",
      "name": "Write Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        420
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const accounts = $json.accounts || [];\nconst high = accounts.filter((account) => account.tier === 'high');\nconst lines = accounts.map((account) => '\u2022 [' + account.tier + ' ' + account.score + '] ' + (account.company || account.email) + ' \u2014 ' + account.reasons);\nconst slackText = '*Churn risk* ' + accounts.length + ' account(s), ' + high.length + ' high\\n' + lines.join('\\n');\nconst html = '<h2>Churn risk</h2><p>' + accounts.length + ' account(s) at medium or high risk, ' + high.length + ' high.</p><ul>' + accounts.map((account) => '<li><strong>' + account.tier + ' ' + account.score + '</strong> \u2014 ' + (account.company || account.email) + ' (' + account.email + ', MRR ' + account.mrr + ')<br>' + account.reasons + '</li>').join('') + '</ul>';\nreturn [{\n  json: {\n    slackText,\n    subject: 'Churn risk: ' + high.length + ' high, ' + accounts.length + ' total',\n    html,\n    to: $('Settings').first().json.alertEmail,\n  },\n}];"
      }
